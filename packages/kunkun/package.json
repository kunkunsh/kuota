{
  "name": "@kuota/kunkun",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "vp pack src/index.ts",
    "build:web": "vp build",
    "test": "vp test run"
  },
  "dependencies": {
    "@iconify/react": "^6.0.4",
    "@kuota/core": "workspace:*",
    "@kuota/history": "workspace:*",
    "@tanstack/react-router": "^1.170.46",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5"
  },
  "kunkun": {
    "identifier": "sh.kunkun.kuota",
    "name": "Kuota",
    "shortDescription": "Truthful AI subscription and quota dashboard",
    "longDescription": "Monitor and forecast OpenAI Codex, Claude, and Google Antigravity quotas with pacing markers and honest uncertainty.",
    "permissions": [
      "storage",
      "notifications"
    ],
    "commands": [
      {
        "name": "dashboard",
        "title": "Kuota Quota Dashboard",
        "mode": "custom-view",
        "main": "dist/index.js",
        "dist": "dist",
        "devMain": "http://127.0.0.1:5173",
        "window": {
          "title": "Kuota · AI Quota & Usage",
          "width": 1280,
          "height": 840,
          "transparent": true,
          "titleBarStyle": "hidden",
          "vibrancy": "sidebar"
        }
      },
      {
        "name": "island",
        "title": "Kuota Island Glance",
        "mode": "worker-view",
        "main": "dist/island.js"
      }
    ]
  }
}
