{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kuota",
  "version": "0.1.0",
  "identifier": "sh.kunkun.kuota.desktop",
  "build": {
    "beforeDevCommand": "bun --cwd ../.. dev",
    "frontendDist": "../../../packages/kunkun/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kuota · AI Quota & Usage",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "zoomHotkeysEnabled": true,
        "visible": true
      },
      {
        "label": "tray",
        "title": "Kuota Menu Bar",
        "width": 420,
        "height": 720,
        "minWidth": 360,
        "minHeight": 540,
        "maxWidth": 640,
        "maxHeight": 1000,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "visible": false
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https://*;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Truthful AI subscription and quota dashboard",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/kunkunsh/kuota/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2QkI1Q0NGNEM3RDNDNTQKUldSVVBIMU16MXk3eHRxdWd0MEUvbEZMK05JeFpaeWFBcjI5OExhN0VSNGdZaTB0ckhqYzRBZTUK"
    }
  }
}
