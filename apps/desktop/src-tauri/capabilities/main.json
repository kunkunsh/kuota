{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Permissions for the Kuota desktop workbench: window dragging, zoom controls, app info, and event listeners.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:app:default",
    "core:window:allow-start-dragging",
    "core:webview:allow-set-webview-zoom",
    "process:allow-restart"
  ]
}
